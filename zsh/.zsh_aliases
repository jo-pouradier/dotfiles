alias plz='sudo'

# LS
alias ls='ls --color'
alias la='ls -a'
alias ll='ls -lh'
alias lal='ls -lah'


# TMUX
alias tse='tmux-sessionizer'
alias ta='tmux a'
alias tt='tig --all'


# GIT 
alias grbim='gsw $(git_main_branch) && git pull --rebase && gsw - && git rebase -i $(git_main_branch)'
alias grpo='git remote prune origin'

# UTILS
alias oc='opencode'
alias bubu="brew update && brew upgrade -y"
alias n='nvim'
alias cl='clear'
