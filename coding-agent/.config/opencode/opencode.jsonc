{
    "$schema": "https://opencode.ai/config.json",
    "update": "auto",
    "lsp": true,
    "permissions": [
        { "action": "edit", "resource": "*", "effect": "allow" },
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        // Automode: allow all shell commands and outside-workspace access.
        // Destructive ops below still ask (last match wins).
        { "action": "shell", "resource": "*", "effect": "allow" },
        { "action": "external_directory", "resource": "~/Desktop/workspace/*", "effect": "allow" },
        // Require approval for destructive ops
        { "action": "shell", "resource": "git push *", "effect": "ask" },
        { "action": "shell", "resource": "git reset *", "effect": "ask" },
        { "action": "shell", "resource": "git rebase *", "effect": "ask" },
        { "action": "shell", "resource": "npm install *", "effect": "ask" },
        { "action": "shell", "resource": "rm *", "effect": "ask" }
    ],
    // File watcher - ignore noisy directories
    "watcher": {
        "ignore": [
            "node_modules/**",
            "dist/**",
            "build/**",
            "target/**",
            ".git/**",
            ".idea/**",
            ".vscode/**",
            "__pycache__/**",
            "*.pyc"
        ]
    },
    // MCP servers
    "mcp": {
        "servers": {
            "figma": {
                "type": "remote",
                "url": "https://mcp.figma.com/mcp",
                "disabled": false,
                "oauth": {}
            },
            "context7": {
                "type": "remote",
                "url": "https://mcp.context7.com/mcp",
                "disabled": false
            },
            "atlassian": {
                "disabled": false,
                "type": "remote",
                "url": "https://mcp.atlassian.com/v1/mcp"
            },
            "chrome-devtools": {
                "type": "local",
                "command": [
                    "npx",
                    "chrome-devtools-mcp@latest"
                ]
            }
        }
    },
    // Custom providers
    "disabled_providers": [ "opencode"],
    "model": "deepseek/deepseek-v4.1-flash",
    "providers": {
        "ollama": {
            "package": "aisdk:@ai-sdk/openai-compatible",
            // "name": "Ollama (local)",
            "settings": {
                "baseURL": "http://localhost:11434/v1"
            },
            "models": {
                "gpt-oss:20b": {},
                "gemma4:e2b-mlx": {}
            }
        },
        "llama": {
            "package": "aisdk:@ai-sdk/openai-compatible",
            "name": "llama.cpp (local)",
            "settings": {
                "baseURL": "http://127.0.0.1:8080/v1"
            },
            "models": {
                "devstral:ctx": {},
                "ggml-org/gpt-oss-20b-GGUF:MXFP4": { "name": "gpt-oss:20b-llama"},
                "unsloth/Qwen3-Coder-30B-A3B-Instruct-GGUF:Q4_K_M": {"name": "qwen3-coder:30b"}
            }
        },
        "google": {
            "settings": {
                "projectId": "{env:GOOGLE_PROJECT_ID}"
            }
        }
    },
    "plugins": [
        "opencode-gemini-auth@latest",
        "opencode-notifier"
    ]
}
