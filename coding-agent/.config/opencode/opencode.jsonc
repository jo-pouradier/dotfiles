{
    "$schema": "https://opencode.ai/config.json",
    "autoupdate": true,
    "lsp": true,
    "permission": {
        "edit": "allow",
        "bash": {
            // Safe read-only commands
            "git status": "allow",
            "git diff": "allow",
            "git log": "allow",
            "ls": "allow",
            "cat": "allow",
            "find": "allow",
            "grep": "allow",
            "pwd": "allow",
            "cd": "allow",
            // Build/test commands
            "npm run": "allow",
            "npm test": "allow",
            "mvn": "allow",
            "gradle": "allow",
            "cargo": "allow",
            "go": "allow",
            // Require approval for destructive git ops
            "git push": "ask",
            "git reset": "ask",
            "git rebase": "ask",
            "npm install": "ask",
            "rm": "ask"
        }
    },
    // File watcher - ignore noisy directories
    "watcher": {
        "ignore": [
            "node_modules/**",
            "dist/**",
            "build/**",
            "target/**",
            ".git/**",
            ".idea/**",
            ".vscode/**",
            "__pycache__/**",
            "*.pyc"
        ]
    },
    // MCP servers
    "mcp": {
        "figma": {
            "type": "remote",
            "url": "https://mcp.figma.com/mcp",
            "enabled": true,
            "oauth": {}
        },
        "context7": {
            "type": "remote",
            "url": "https://mcp.context7.com/mcp",
            "enabled": true
        },
        "atlassian": {
            "enabled": true,
            "type": "remote",
            "url": "https://mcp.atlassian.com/v1/mcp"
        },
        "chrome-devtools": {
            "type": "local",
            "command": [
                "npx",
                "chrome-devtools-mcp@latest"
            ]
        }
    },
    // Custom providers
    "disabled_providers": [ "opencode"],
    "provider": {
        "ollama": {
            "npm": "@ai-sdk/openai-compatible",
            // "name": "Ollama (local)",
            "options": {
                "baseURL": "http://localhost:11434/v1"
            },
            "models": {
                "gpt-oss:20b": {},
                "gemma4:e2b-mlx": {}
            }
        },
        "llama": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "llama.cpp (local)",
            "options": {
                "baseURL": "http://127.0.0.1:8080/v1"
            },
            "models": {
                "devstral:ctx": {},
                "ggml-org/gpt-oss-20b-GGUF:MXFP4": { "name": "gpt-oss:20b-llama"},
                "unsloth/Qwen3-Coder-30B-A3B-Instruct-GGUF:Q4_K_M": {"name": "qwen3-coder:30b"}
            }
        },
        "google": {
            "options": {
                "projectId": "{env:GOOGLE_PROJECT_ID}"
            }
        }
    },
    "plugin": [
        "opencode-gemini-auth@latest",
        "opencode-notifier"
    ]
}
